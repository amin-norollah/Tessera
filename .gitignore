# --- Rust / Cargo ---
/target/
**/target/
# Local-only build config (e.g. a redirected target-dir); not meant to be shared.
/.cargo/
# Cargo.lock is committed for the workspace's binaries (tessera-cli, tessera-server);
# if a published library crate is split out later, ignore its own lock instead.
*.pdb

# --- Private docs and notes (kept local, never published) ---
# All Markdown is private by default. Only the public files below are tracked.
/docs/
CLAUDE.md
AGENTS.md
/.claude/
*.md
!/README.md
!/CONTRIBUTING.md
!/CHANGELOG.md
!/CODE_OF_CONDUCT.md
!/SECURITY.md
!/.github/**/*.md
!/guide/*.md
!/web/README.md

# --- Node tooling (Prettier / Husky / lint-staged) ---
/node_modules/

# --- WASM build output ---
/crates/tessera-wasm/pkg/
/crates/tessera-wasm/target/
*.wasm

# --- Web frontend (Angular / WebGPU UI) ---
web/node_modules/
web/dist/
web/.angular/
web/.vite/
web/coverage/
*.tsbuildinfo

# --- FFI / native build artifacts (DSENT, ORION, HotSpot, McPAT) ---
/crates/*-sys/build/
/crates/*-sys/**/*.o
/crates/*-sys/**/*.a
/crates/*-sys/**/*.so
/crates/*-sys/**/*.dylib
/crates/*-sys/**/*.dll

# --- Simulation output (traces, snapshots, exported figures) ---
/runs/
/traces/
/results/*.*
*.parquet
*.arrow
*.duckdb

# --- Editors / IDE ---
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# --- OS cruft ---
.DS_Store
Thumbs.db
desktop.ini

# --- Local env / secrets ---
.env
.env.local

# --- Logs ---
*.log

# --- Scratch test files ---
/test*.*
