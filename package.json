{
  "name": "tessera",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace root for the Tessera NoC simulator: shared tooling (Prettier + Husky), the Rust engine in ./crates, and the Angular front-end in ./web.",
  "license": "MIT OR Apache-2.0",
  "workspaces": [
    "web"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sim:build": "cargo build --workspace",
    "sim:build:release": "cargo build --workspace --release",
    "sim:test": "cargo test --workspace",
    "sim:lint": "cargo clippy --workspace --all-targets -- -D warnings",
    "sim:fmt": "cargo fmt --all",
    "sim:fmt:check": "cargo fmt --all --check",
    "sim:run": "cargo run --release -p tessera-cli --",
    "sim:sweep": "cargo run --release -p tessera-cli -- --width 8 --height 8 --out curve.csv",
    "web:start": "npm run start --workspace web",
    "web:build": "npm run build --workspace web",
    "web:test": "npm run test --workspace web",
    "verify": "npm run format:check && npm run sim:fmt:check && npm run sim:lint && npm run sim:test",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,ts,tsx,html,css,scss,json,jsonc,yml,yaml,md}": "prettier --write",
    "*.rs": "rustfmt --edition 2021"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.5"
  }
}
